{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "apps/web/*"
      ],
      "@outcometrik/ui": [
        "libs/ui/core/src/index.ts"
      ],
      "@outcometrik/api": [
        "libs/ui/api/src/index.ts"
      ],
      "@outcometrik/system": [
        "libs/ui/modules/system/src/index.ts"
      ],
      "@outcometrik/access": [
        "libs/ui/modules/access/src/index.ts"
      ],
      "@outcometrik/ui/*": [
        "libs/ui/core/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
