{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api",
  "projectType": "application",
  "implicitDependencies": ["api-access"],
  "targets": {
    "sync": {
      "command": "uv sync --all-groups",
      "options": { "cwd": "apps/api" },
      "cache": false
    },
    "serve": {
      "command": "../../tools/serve-api.sh",
      "options": { "cwd": "apps/api" },
      "dependsOn": ["sync"],
      "continuous": true,
      "cache": false
    },
    "worker": {
      "command": "uv run celery -A config worker --loglevel=INFO",
      "options": { "cwd": "apps/api" },
      "dependsOn": ["sync"],
      "continuous": true,
      "cache": false
    },
    "lint": {
      "command": "uv run ruff check . ../../libs/modules/access && uv run ruff format --check . ../../libs/modules/access",
      "options": { "cwd": "apps/api" },
      "dependsOn": ["sync"]
    },
    "test": {
      "command": "uv run pytest",
      "options": { "cwd": "apps/api" },
      "dependsOn": ["sync"]
    },
    "build": {
      "command": "docker build -f apps/api/Dockerfile -t outcometrik-api:local .",
      "options": { "cwd": "." },
      "cache": false
    }
  }
}
