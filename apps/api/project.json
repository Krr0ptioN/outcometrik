{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api",
  "projectType": "application",
  "targets": {
    "sync": { "command": "uv sync --all-groups", "options": { "cwd": "apps/api" }, "cache": false },
    "serve": { "command": "uv run python manage.py runserver 0.0.0.0:8000", "options": { "cwd": "apps/api" }, "dependsOn": ["sync"], "continuous": true, "cache": false },
    "worker": { "command": "uv run celery -A config worker --loglevel=INFO", "options": { "cwd": "apps/api" }, "dependsOn": ["sync"], "continuous": true, "cache": false },
    "lint": { "command": "uv run ruff check . && uv run ruff format --check .", "options": { "cwd": "apps/api" }, "dependsOn": ["sync"] },
    "test": { "command": "uv run pytest", "options": { "cwd": "apps/api" }, "dependsOn": ["sync"] },
    "build": { "command": "docker build -t cse-3xx-api:local .", "options": { "cwd": "apps/api" }, "cache": false }
  }
}
