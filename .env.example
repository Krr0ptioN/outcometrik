# Copy to .env and use the same password for Compose and the host-run API.
POSTGRES_DB=outcometrik
POSTGRES_USER=outcometrik
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only
# Password for the k6 load-test users
PERF_LOAD_PASSWORD=
# Local-only password used by `manage.py seed_demo` (DEBUG + local DB only).
DEMO_SEED_PASSWORD=choose-a-local-demo-password
